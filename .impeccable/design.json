  "narrative": {
    "northStar": "The K3 portrait control panel",
    "overview": "The user's two supplied screenshots and the upstream tdunl410/printer-ui-klipper interface define this visual system. Charcoal surfaces, violet actions and the K3 printer render establish the identity. This is an extension of that interface; HelixScreen's native dashboard was explicitly rejected.\n\nThe panel is dense enough for printer operation, with generous touch controls, clear telemetry and a permanent labeled navigation dock. Appearance changes stay within the existing visual structure. The reference composition is the authority; the metaphor below is descriptive shorthand.",
    "keyCharacteristics": [
      "Charcoal layers with violet selected actions.",
      "A prominent printer render, temperature chips and Print action.",
      "Circular XY motion controls beside separate Z buttons.",
      "Four permanent icon-and-text navigation tabs."
    ],
    "rules": [
      {
        "name": "The Reference Palette Rule",
        "body": "Preserve charcoal surfaces and the existing theme system when adding controls; customization changes accent treatment within this structure.",
        "section": "colors"
      },
      {
        "name": "The Reserved Navigation Rule",
        "body": "Content must scroll above the dock rather than disappear beneath it; preserve reserved flex space at every supported text size.",
        "section": "layout"
      }
    ],
    "dos": [
      "**Do** preserve the supplied K3 screenshots and existing printer render as the visual authority.",
      "**Do** keep the header and all four labeled tabs reachable while the middle scrolls.",
      "**Do** retain the prominent Print action, quick-action rows, radial XY jog and separate Z buttons.",
      "**Do** verify custom accents, largest text and short portrait viewports when changing shared controls.",
      "**Do** keep appearance imports restricted to the versioned accent and text-size profile."
    ],
    "donts": [
      "**Don't** substitute the rejected native HelixScreen dashboard or an icon-only grid.",
      "**Don't** shrink the entire interface to fit a shorter viewport; allow the middle to scroll.",
      "**Don't** treat disconnected readings as live printer telemetry.",
      "**Don't** mix printer credentials, machine state or printer configuration into appearance exports."
    ]
  }
}
